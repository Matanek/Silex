class FrameState {
    var first:int[]
    var second:int[]
    var third:int[]
    var fourth:int[]
    var fifth:int[]
    var sixth:int[]

    init() {
        self.first = []
        self.second = []
        self.third = []
        self.fourth = []
        self.fifth = []
        self.sixth = []
    }

    func begin_frame() {
        self.first = []
        self.second = []
        self.third = []
        self.fourth = []
        self.fifth = []
        self.sixth = []
    }
}

test "repeatedly replace owned list fields" {
    var state = FrameState()
    for index in 0...200000 {
        state.begin_frame()
    }
}
