class OrderedValues {
    var items:int[]

    init() {
        self.items = [0, 1, 2, 3]
    }

    func rotate() {
        self.items.swap(0, 1)
        self.items.swap(1, 2)
        self.items.swap(2, 3)
    }
}

class ReplacementToken {
    static var drops:int = 0
    let id:int

    init(id:int) { self.id = id }
    drop { ReplacementToken.drops++ }
}

class ReplacementCache {
    var entries:ReplacementToken[]

    init() { self.entries = [] }

    func set(entry:ReplacementToken) {
        if self.entries.is_empty() { self.entries.append(entry) }
        else { self.entries[0] = entry }
    }
}

test "replacing elements preserves ownership of a class field list" {
    var values = OrderedValues()
    for iteration in 0...10000 {
        values.rotate()
    }
    assert(values.items.count() == 4)
    assert(values.items[0] == 0)
    assert(values.items[1] == 1)
    assert(values.items[2] == 2)
    assert(values.items[3] == 3)
}

test "indexed assignment releases only the replaced class element" {
    ReplacementToken.drops = 0
    {
        var cache = ReplacementCache()
        cache.set(ReplacementToken(1))
        cache.set(ReplacementToken(2))
        assert(ReplacementToken.drops == 1)
        cache.set(ReplacementToken(3))
        assert(ReplacementToken.drops == 2)
    }
    assert(ReplacementToken.drops == 3)
}
