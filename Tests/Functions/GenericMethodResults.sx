class Base {
    func value() int? { return 42 }
    func nested() int?? { return 7 }
}

class Middle:Base {}
class Leaf:Middle {}
class Override:Base {
    override func value() int? { return 99 }
}

struct Store {
    func identity<T>(value:T) T { return value }
}

func identity<T>(value:T) T { return value }

test "infer inherited results and unwrap exactly one optional layer in generic calls" {
    var leaf = Leaf()
    var changed = Override()
    var store = Store()
    assert(store.identity<int>(leaf.value()!) == 42)
    assert(store.identity(leaf.value()!) == 42)
    assert(identity<int>(leaf.value()!) == 42)
    assert(store.identity<int?>(leaf.nested()!)! == 7)
    assert(store.identity<int>(leaf.nested()!!) == 7)
    assert(store.identity<int>(changed.value()!) == 99)
}

struct ClipResult { var value:int = 0 }
struct ClipFactory { func play() ClipResult { return ClipResult() } }
func make_clip(duration:float = 1.0) ClipFactory { return ClipFactory() }
class ResultConsumer {
    var calls:int = 0
    func accept<T>(value:T) { self.calls++ }
    func build() {
        self.accept(make_clip().play()..value = 2)
        let factory = make_clip()
        self.accept(factory.play())
    }
}

test "infer nested free function results inside concrete class methods" {
    var consumer = ResultConsumer()
    consumer.build()
    assert(consumer.calls == 2)
}
