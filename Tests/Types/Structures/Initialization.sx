func initial_values() int[] { return [1] }

struct Channel<T> {
    let current:T
    var history:T[]

    init(current:T) {
        self.current = current
        self.history = [current]
    }

    func remember(value:T) { self.history.append(value) }
}

class Defaults {
    var values:int[] = initial_values()
    var channel:Channel<float> = Channel<float>(1.5)
}

struct ChannelPair {
    let first:Channel<float>
    let second:Channel<float>

    init(first:float, second:float) {
        self.first = Channel<float>(first)
        self.second = Channel<float>(second)
    }
}

class ChannelOwner {
    var first:Channel<float>
    var second:Channel<float>

    init(first:float, second:float) {
        self.first = Channel<float>(first)
        self.second = Channel<float>(second)
    }
}

test "field initializer expressions run for each instance" {
    var first = Defaults()
    var second = Defaults()
    first.values.append(2)
    first.channel.remember(2.5)

    assert(first.values.count() == 2)
    assert(second.values.count() == 1)
    assert(first.channel.history.count() == 2)
    assert(second.channel.history.count() == 1)
}

test "constructors initialize non-intrinsic structure fields" {
    let pair = ChannelPair(2.0, 3.0)

    assert(pair.first.current == 2.0)
    assert(pair.second.current == 3.0)
    assert(pair.first.history.count() == 1)
    assert(pair.second.history.count() == 1)
}

test "constructors initialize non-intrinsic class fields" {
    var owner = ChannelOwner(4.0, 5.0)
    owner.first.remember(6.0)

    assert(owner.first.current == 4.0)
    assert(owner.second.current == 5.0)
    assert(owner.first.history.count() == 2)
    assert(owner.second.history.count() == 1)
}
