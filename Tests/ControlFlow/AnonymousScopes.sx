struct Counter { var value:int; func increment() { self.value++ } }

test "anonymous scopes execute once and release bound receiver borrows" {
    var counter = Counter(value:0)
    {
        let increment:func() = counter.increment
        increment()
    }
    counter.value += 1
    if counter.value != 2 { panic("anonymous scope") }
}

test "successive anonymous scopes can reuse local names" {
    var total = 0
    { let value = 20; total += value }
    { let value = 22; total += value }
    if total != 42 { panic("scope reuse") }
}
