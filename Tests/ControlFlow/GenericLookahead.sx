struct Counter {
    let change:int
    func ready(count:int) bool { return self.change < 4 && count > (self.change+1)*5 }
}
func identity<T>(value:T) T { return value }

test "comparisons before parentheses do not become generic arguments" {
    let lower = 1; let upper = 9; let other = 4
    assert(lower < 4 && upper > (5))
    assert(lower < other && upper > (5))
    assert(lower < 0 || upper > (5))
    assert(Counter(change:1).ready(11))
    assert(!Counter(change:4).ready(100))
}

test "generic lookahead retains array tuple and function types" {
    let values:int[2] = [7,9]
    assert(identity<int[2]>(values)[1] == 9)
    let pair:(first:int, second:str) = (first:42, second:"answer")
    assert(identity<(first:int, second:str)>(pair).first == 42)
    let callback = func(value:int) int { return value+1 }
    let typed = identity<func(int) int>(callback)
    assert(typed(41) == 42)
}
