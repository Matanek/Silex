func classify(value:int) str {
    if value < 0 { return "negative" }
    elif value == 0 { return "zero" }
    else { return "positive" }
}

func classify_alternatives(value:int) int {
    if value == 0 { return 10 }
    else if value == 1 { return 11 }
    else if value == 2 { return 12 }
    elif value == 3 { return 13 }
    else if value == 4 { return 14 }
    else { return 15 }
}

test "repeated else if and mixed elif alternatives select each branch" {
    for value in 0...6 {
        assert(classify_alternatives(value) == value + 10)
    }
}

test "conditional branches select one path" {
    if classify(-1) != "negative" || classify(0) != "zero" || classify(1) != "positive" {
        panic("conditional branches")
    }
}

test "while break and continue control the nearest loop" {
    var value = 0
    var total = 0
    while value < 10 {
        value++
        if value % 2 == 0 { continue }
        if value > 7 { break }
        total += value
    }
    if total != 16 { panic("while loop controls") }
}

test "range and indexed collection iteration are complete" {
    var values = [10, 20, 30]
    for index, var value in values.indexed() { value += index }
    var total = 0
    for i in 0...values.count() { total += values[i] }
    if total != 63 { panic("range or indexed iteration") }
}
