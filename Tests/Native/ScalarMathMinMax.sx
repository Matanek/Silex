use Interop.C
use STD.Math

func float32_bits(value:float32) uint32 {
    var stored = value
    return C.load<uint32>(C.address_bits(C.mutable_pointer(stored)), 0 as uint)
}

func float64_bits(value:float64) uint {
    var stored = value
    return C.load<uint>(C.address_bits(C.mutable_pointer(stored)), 0 as uint)
}

func float32_from_bits(bits:uint32) float32 {
    var stored = bits
    return C.load<float32>(C.address_bits(C.mutable_pointer(stored)), 0 as uint)
}

func float64_from_bits(bits:uint) float64 {
    var stored = bits
    return C.load<float64>(C.address_bits(C.mutable_pointer(stored)), 0 as uint)
}

test "scalar float32 minimum and maximum preserve exact edge semantics" {
    let positive_zero = float32_from_bits(0)
    let negative_zero = float32_from_bits(0x80000000)
    let first_nan = float32_from_bits(0x7fc12345)
    let second_nan = float32_from_bits(0x7fc54321)
    assert(float32_bits(Math.min(positive_zero, negative_zero)) == 0x80000000)
    assert(float32_bits(Math.min(negative_zero, positive_zero)) == 0x80000000)
    assert(float32_bits(Math.max(positive_zero, negative_zero)) == 0)
    assert(float32_bits(Math.max(negative_zero, positive_zero)) == 0)
    assert(float32_bits(Math.min(first_nan, 7.0)) == float32_bits(7.0))
    assert(float32_bits(Math.max(7.0, second_nan)) == float32_bits(7.0))
    assert(float32_bits(Math.min(first_nan, second_nan)) == 0x7fc54321)
    assert(float32_bits(Math.max(first_nan, second_nan)) == 0x7fc54321)
    assert(Math.min(-3.0, 9.0) == -3.0)
    assert(Math.max(-3.0, 9.0) == 9.0)
}

test "scalar float64 minimum and maximum preserve exact edge semantics" {
    let positive_zero = float64_from_bits(0)
    let negative_zero = float64_from_bits(0x8000000000000000)
    let first_nan = float64_from_bits(0x7ff8123456789abc)
    let second_nan = float64_from_bits(0x7ff8abcdef012345)
    assert(float64_bits(Math.min(positive_zero, negative_zero)) == 0x8000000000000000)
    assert(float64_bits(Math.min(negative_zero, positive_zero)) == 0x8000000000000000)
    assert(float64_bits(Math.max(positive_zero, negative_zero)) == 0)
    assert(float64_bits(Math.max(negative_zero, positive_zero)) == 0)
    assert(float64_bits(Math.min(first_nan, 7.0 as float64)) == float64_bits(7.0 as float64))
    assert(float64_bits(Math.max(7.0 as float64, second_nan)) == float64_bits(7.0 as float64))
    assert(float64_bits(Math.min(first_nan, second_nan)) == 0x7ff8abcdef012345)
    assert(float64_bits(Math.max(first_nan, second_nan)) == 0x7ff8abcdef012345)
    assert(Math.min(-3.0 as float64, 9.0 as float64) == (-3.0 as float64))
    assert(Math.max(-3.0 as float64, 9.0 as float64) == (9.0 as float64))
}
