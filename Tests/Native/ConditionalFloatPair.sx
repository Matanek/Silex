use STD.Math

struct AxisResult {
    let normal:Math.Vec3
    let gap:float

    init(normal:Math.Vec3, gap:float) {
        self.normal = normal
        self.gap = gap
    }
}

func rotated_axis(rotation:Math.Quat, index:int) Math.Vec3 {
    if index == 0 { return rotation.rotate(Math.Vec3.right()) }
    if index == 1 { return rotation.rotate(Math.Vec3.up()) }
    return rotation.rotate(Math.Vec3(0.0, 0.0, 1.0))
}

func projection(rotation:Math.Quat, axis:Math.Vec3) float {
    return Math.abs(axis.dot(rotated_axis(rotation, 0))) +
        Math.abs(axis.dot(rotated_axis(rotation, 1))) +
        Math.abs(axis.dot(rotated_axis(rotation, 2)))
}

func probe() AxisResult {
    let first_rotation = Math.Quat.identity()
    let second_rotation = Math.Quat.angle_axis(
        25.0 * Math.pi() / 180.0, Math.Vec3(1.0, 1.0, 1.0)
    )
    let offset = Math.Vec3(1.5, 0.0, 0.0)
    var best_gap = -3.4028235e38
    var best_axis = Math.Vec3.right()
    var index = 0
    while index < 15 {
        var axis = Math.Vec3()
        if index < 3 {
            axis = rotated_axis(first_rotation, index)
        } else if index < 6 {
            axis = rotated_axis(second_rotation, index - 3)
        } else {
            let cross_index = index - 6
            axis = rotated_axis(first_rotation, cross_index / 3).cross(
                rotated_axis(second_rotation, cross_index % 3)
            )
        }
        let squared = axis.length_squared()
        if squared > 0.000000000001 {
            axis = axis.divide(Math.sqrt(squared))
            if offset.dot(axis) < 0.0 { axis = axis.negated() }
            let gap = Math.abs(offset.dot(axis)) -
                projection(first_rotation, axis) -
                projection(second_rotation, axis)
            if gap > best_gap {
                best_gap = gap
                best_axis = axis
            }
        }
        index++
    }
    return AxisResult(best_axis, best_gap)
}

func verify_selected_axis() {
    let result = probe()
    assert(Math.abs(result.normal.x - 1.0) < 0.0001)
    assert(Math.abs(result.normal.y) < 0.0001)
    assert(Math.abs(result.normal.z) < 0.0001)
    assert(Math.abs(result.gap + 0.92553616) < 0.0001)
}

test "conditional SIMD pair copies preserve the selected SAT axis" {
    verify_selected_axis()
}

func main() {
    verify_selected_axis()
}
