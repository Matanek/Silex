class Box {
    var value:int
    var ready:bool

    func update(value:int, ready:bool) {
        self.value = value
        self.ready = ready
    }
}

func main() {
    var box = Box(value:7, ready:false)
    print(box.value)
    print(box.ready)
    box.update(41, true)
    print(box.value)
    print(box.ready)
}
