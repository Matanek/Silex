; Direct runtime contracts generated by ECS adapters and ownership transfers.
; Native classes can lose a zero root before their first root retain; they
; finalize when both counts are zero. Native collection drops at zero are no-ops.
define internal i32 @test_class_counts() {
entry:
  %class = call fastcc ptr @sx_typed_class_alloc(i64 0, i64 1)
  %finalize = call fastcc i1 @sx_typed_class_release(ptr %class, i64 8)
  br i1 %finalize, label %unrooted, label %fail
unrooted:
  call fastcc void @sx_typed_class_free(ptr %class)
  %owned = call fastcc ptr @sx_typed_class_alloc(i64 0, i64 1)
  call fastcc void @sx_typed_class_retain(ptr %owned, i64 16)
  %premature = call fastcc i1 @sx_typed_class_release(ptr %owned, i64 8)
  br i1 %premature, label %fail, label %release
release:
  %last = call fastcc i1 @sx_typed_class_release(ptr %owned, i64 16)
  br i1 %last, label %done, label %fail
done:
  call fastcc void @sx_typed_class_free(ptr %owned)
  call fastcc void @sx_finish()
  ret i32 0
fail:
  ret i32 9
}

define internal i32 @test_collection_counts() {
entry:
  %list = call fastcc ptr @sx_alloc(i64 8)
  call fastcc void @sx_drop(ptr %list, i64 -16)
  %edge.address = getelementptr i8, ptr %list, i64 -16
  %edge = load i64, ptr %edge.address
  %valid = icmp eq i64 %edge, 0
  br i1 %valid, label %transfer, label %fail
transfer:
  call fastcc void @sx_retain(ptr %list, i64 -16)
  call fastcc void @sx_drop(ptr %list, i64 -24)
  call fastcc void @sx_drop(ptr %list, i64 -24)
  %root.address = getelementptr i8, ptr %list, i64 -24
  %root = load i64, ptr %root.address
  %zero = icmp eq i64 %root, 0
  br i1 %zero, label %done, label %fail
done:
  call fastcc void @sx_drop(ptr %list, i64 -16)
  call fastcc void @sx_finish()
  ret i32 0
fail:
  ret i32 9
}
