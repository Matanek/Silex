bb2:
    %5:int = load $0:int
    %6:int = const 997
    %7:int = rem %5, %6
    %8:int = call @evaluate(%7)
    store $0:int, %8
    %9:int = load $1:int
    %10:int = const 1
    %11:int = add %9, %10
    store $1:int, %11
    jump bb1
bb3:
    %12:int = load $0:int
    %13:int = const 106
    %14:bool = eq %12, %13
