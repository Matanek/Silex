struct @int[..] {
}

struct @int[] {
}

func @endpoints(%0:@int[..]) -> int {
entry:
    %1:int = const 0
    %2:int = collection.load %0, %1
    %3:int = const -1
    %4:int = collection.load %0, %3
    %5:int = add %2, %4
    return %5
}

func @evaluate(%0:int) -> int {
entry:
    %1:int = const 3
    %2:int = const 1
    %3:int = add %0, %2
    %4:int = const 7
    %5:@int[] = list.init [%0, %1, %3, %4]
    %6:int = const 0
    %7:int = collection.count %5
    %8:@int[..] = collection.view %5, %6, %7
    %9:int = call @endpoints(%8)
    list.drop %5
    return %9
}

func @main() -> void {
entry:
    %0:int = const 1
    store $0:int, %0
    %1:int = const 0
    store $1:int, %1
    jump bb1
bb1:
    %2:int = load $1:int
    %3:int = const 5000
