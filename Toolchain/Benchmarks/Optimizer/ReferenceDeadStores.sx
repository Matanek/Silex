struct Pair {
    var x:int
    var y:int
}

func overwrite(value:&Pair, first:int, second:int) {
    value.x = first
    value.x = second
}

func observed(left:&Pair, right:&Pair, first:int, second:int) int {
    left.x = first
    let seen = right.x
    left.x = second
    return seen + left.x
}

func main() {
    var replaced = Pair(x:3, y:4)
    overwrite(replaced, 10, 11)
    print(replaced.x)

    var shared = Pair(x:5, y:6)
    print(observed(shared, shared, 20, 21))
    print(shared.x)
}
