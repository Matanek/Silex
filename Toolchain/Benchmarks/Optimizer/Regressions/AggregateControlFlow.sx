struct Pair {
    var x:float
    var y:float
}

func choose(value:float, positive:bool) Pair {
    if positive { return Pair(x:value, y:value + 1.0) }
    return Pair(x:-value, y:value - 1.0)
}

func accumulate(positive:bool) float {
    let scale = Pair(x:2.0, y:3.0)
    var total = 0.0
    var index = 0
    while index < 8 {
        var value = choose(index as float, positive)
        let snapshot = Pair(x:value.x * scale.x, y:value.y * scale.y)
        if index % 2 == 0 { value.x = 100.0 }
        if positive { total += snapshot.x } else { total -= snapshot.x }
        total += snapshot.y
        index++
    }
    return total
}

func transform(seed:float, positive:bool) float {
    var total = seed
    if positive { total += 1.0 }
    var point = Pair(x:seed, y:seed + 1.0)
    let snapshot = point
    point.x += total
    point.y *= 2.0
    return point.x + point.y + snapshot.x
}

func change(point:&Pair) {
    point.x += point.y
    point.y = -point.y
}

func borrowed_snapshot() float {
    var point = Pair(x:3.0, y:4.0)
    let snapshot = point
    change(point)
    return point.x + point.y + snapshot.x
}

func main() {
    assert(accumulate(true) == 164.0)
    assert(accumulate(false) == 116.0)
    assert(transform(3.0, true) == 18.0)
    assert(transform(3.0, false) == 17.0)
    assert(borrowed_snapshot() == 6.0)
    print("aggregate control flow preserved")
}
