struct Position {
    var x:int
    var y:int
}

struct Vertex {
    var position:Position
}

func main() {
    var fixed:int[4] = [2, 4, 6, 8]
    fixed[1] = 40
    fixed[-1] += 3

    var dynamic:int[] = [1, 2, 3]
    let detached = dynamic
    dynamic[0] = 9
    dynamic.append(4)
    dynamic.swap(1, -1)

    var nested:int[][] = [[10, 11], [20, 21]]
    nested[1][0] = 70

    var vertices:Vertex[] = [Vertex(position:Position(x:1, y:2))]
    vertices[0].position.x = 7
    vertices[0].position.y += 3

    print(fixed[0], " ", fixed[1], " ", fixed[2], " ", fixed[3])
    print(dynamic.count(), " ", dynamic[0], " ", dynamic[1], " ", dynamic[-1])
    print(detached[0], " ", detached[1], " ", nested[0][-1], " ", nested[1][0])
    print(vertices[0].position.x, " ", vertices[0].position.y)
}
