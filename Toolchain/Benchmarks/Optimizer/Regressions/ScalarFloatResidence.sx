func barrier(value:int) int { print(value == 32); return value }
func change(value:&float64) { value = -7.0 }
func regions(count:int) float64 {
    var a:float64 = 1.0; var b:float64 = 2.0
    var c:float64 = 3.0; var d:float64 = 4.0
    var e:float64 = 5.0; var f:float64 = 6.0
    var g:float64 = 7.0; var h:float64 = 8.0
    var index = 0
    while index < count {
        a += 1.0; b += 2.0; c += 3.0; d += 4.0
        e += 5.0; f += 6.0; g += 7.0; h += 8.0
        index++
    }
    return a + b + c + d + e + f + g + h
}
func across_call(value:float64, count:int) float64 {
    var addressed = value
    var total = value + 2.0
    var index = 0
    while index < count {
        total += addressed
        if index == 1 { change(addressed) }
        index++
    }
    return total
}
func edges(zero:float64, nan:float64, flag:bool) {
    var selected = zero
    if flag { selected = -zero }
    print(1.0 / selected > 0.0)
    let propagated = nan + 1.0
    print(propagated != propagated)
    let narrow = 1024.0 as float32
    let wide = narrow as float64
    print(wide == 1024.0)
    print((-wide as int64) == -1024)
}
func main() {
    let count = barrier(32)
    print(regions(count) == 1188.0)
    print(across_call(3.0, 4) == -3.0)
    edges(-0.0, 0.0 / 0.0, true)
    var a:float32 = 0.5; var b:float32 = 1.0
    var index = 0
    while index < count {
        a = a * 0.5 + 0.25
        b = b * 0.5 + 0.5
        index++
    }
    print(a == 0.5); print(b == 1.0)
}
