func choose64(value:float64, condition:bool) float64 {
    var result = value
    if condition {
        result = value + 1.5
    }
    return result * 2.0
}

func choose32(value:float32, condition:bool) float32 {
    var result = value
    if condition {
        result = value + 1.5
    }
    return result * 2.0
}

func main() {
    assert(choose64(1.0, false) == 2.0)
    assert(choose64(1.0, true) == 5.0)
    assert(choose32(1.0, false) == 2.0)
    assert(choose32(1.0, true) == 5.0)
    print("SSA critical edges preserved")
}
