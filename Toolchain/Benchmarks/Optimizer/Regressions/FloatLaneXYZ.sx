struct Vec3 {
    let x:float
    let y:float
    let z:float
}

func transform(value:Vec3, scale:float) Vec3 {
    return Vec3(
        x:value.x * scale + 1.0,
        y:value.y * scale + 2.0,
        z:value.z * scale + 3.0
    )
}

func main() {
    let changed = transform(Vec3(x:4.0, y:5.0, z:6.0), 2.0)
    print(changed.x == 9.0)
    print(changed.y == 12.0)
    print(changed.z == 15.0)
}
