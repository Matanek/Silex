class Accumulator {
    var value:int

    func add(amount:int) {
        self.value += amount
    }
}

func calculate(iterations:int, seed:int) int {
    var counter = Accumulator(value:seed)
    var index = 0
    while index < iterations {
        if index % 2 == 0 {
            counter.add(index + 1)
        } else {
            counter.add(1)
        }
        index += 1
    }
    return counter.value
}

func main() {
    print(calculate(0, 5) == 5)
    print(calculate(1, 5) == 6)
    print(calculate(4, 0) == 6)
    print(calculate(10, 0) == 30)
    print(calculate(-1, 7) == 7)
}
