// One-point preparation adapted from Box2D 3.1.1 contact_solver.c.
// Revision 8c661469c9507d3ad6fbd2fea3f1aa71669c2fe3.
// Copyright (c) 2023 Erin Catto. MIT: Oracle2D/Box2D-LICENSE.txt.
// Complete preparation arithmetic; graph lookup and runtime timing excluded.

struct Input {
    var ma:float
    var mb:float
    var ia:float
    var ib:float
    var nx:float
    var ny:float
    var ax:float
    var ay:float
    var bx:float
    var by:float
    var separation:float
    var vax:float
    var vay:float
    var wa:float
    var vbx:float
    var vby:float
    var wb:float
    var normal:float
    var tangent:float
    var rolling:float
    var friction:float
    var restitution:float
    var tangent_speed:float
    var rolling_resistance:float
}

struct Prepared {
    var separation:float
    var normal_mass:float
    var tangent_mass:float
    var relative_velocity:float
    var rolling_mass:float
    var normal:float
    var tangent:float
    var rolling:float
    var friction:float
    var restitution:float
    var tangent_speed:float
    var rolling_resistance:float
    var bias_rate:float
    var mass_scale:float
    var impulse_scale:float
    var nx:float
    var ny:float
    var ax:float
    var ay:float
    var bx:float
    var by:float
    var ma:float
    var mb:float
    var ia:float
    var ib:float
    var total:float
}

func prepare(input:@Input, warm:bool) Prepared {
    var out = Prepared()
    var warm_scale = 0.0
    if warm { warm_scale = 1.0 }
    out.separation = input.separation -
        ((input.bx - input.ax) * input.nx + (input.by - input.ay) * input.ny)
    let rn_a = input.ax * input.ny - input.ay * input.nx
    let rn_b = input.bx * input.ny - input.by * input.nx
    let kn = input.ma + input.mb + input.ia * rn_a * rn_a + input.ib * rn_b * rn_b
    if kn > 0.0 { out.normal_mass = 1.0 / kn }
    let tx = input.ny
    let ty = -input.nx
    let rt_a = input.ax * ty - input.ay * tx
    let rt_b = input.bx * ty - input.by * tx
    let kt = input.ma + input.mb + input.ia * rt_a * rt_a + input.ib * rt_b * rt_b
    if kt > 0.0 { out.tangent_mass = 1.0 / kt }
    let kr = input.ia + input.ib
    if kr > 0.0 { out.rolling_mass = 1.0 / kr }
    var vax = copy input.vax
    var vay = copy input.vay
    var wa = copy input.wa
    var vbx = copy input.vbx
    var vby = copy input.vby
    var wb = copy input.wb
    if input.ma == 0.0 { vax = 0.0; vay = 0.0; wa = 0.0 }
    if input.mb == 0.0 { vbx = 0.0; vby = 0.0; wb = 0.0 }
    out.relative_velocity = input.nx * ((vbx - wb * input.by) - (vax - wa * input.ay)) +
        input.ny * ((vby + wb * input.bx) - (vay + wa * input.ax))
    out.normal = warm_scale * input.normal
    out.tangent = warm_scale * input.tangent
    out.rolling = warm_scale * input.rolling
    out.bias_rate = 12.0
    out.mass_scale = 0.75
    out.impulse_scale = 0.25
    if input.ma == 0.0 || input.mb == 0.0 {
        out.bias_rate = 24.0
        out.mass_scale = 0.875
        out.impulse_scale = 0.125
    }
    out.friction = input.friction
    out.restitution = input.restitution
    out.tangent_speed = input.tangent_speed
    out.rolling_resistance = input.rolling_resistance
    out.nx = input.nx
    out.ny = input.ny
    out.ax = input.ax
    out.ay = input.ay
    out.bx = input.bx
    out.by = input.by
    out.ma = input.ma
    out.mb = input.mb
    out.ia = input.ia
    out.ib = input.ib
    return out
}

func observe(actual:Prepared, expected:Prepared) {
    print(actual.separation == expected.separation)
    print(actual.normal_mass == expected.normal_mass)
    print(actual.tangent_mass == expected.tangent_mass)
    print(actual.relative_velocity == expected.relative_velocity)
    print(actual.rolling_mass == expected.rolling_mass)
    print(actual.normal == expected.normal)
    print(actual.tangent == expected.tangent)
    print(actual.rolling == expected.rolling)
    print(actual.friction == expected.friction)
    print(actual.restitution == expected.restitution)
    print(actual.tangent_speed == expected.tangent_speed)
    print(actual.rolling_resistance == expected.rolling_resistance)
    print(actual.bias_rate == expected.bias_rate)
    print(actual.mass_scale == expected.mass_scale)
    print(actual.impulse_scale == expected.impulse_scale)
    print(actual.nx == expected.nx)
    print(actual.ny == expected.ny)
    print(actual.ax == expected.ax)
    print(actual.ay == expected.ay)
    print(actual.bx == expected.bx)
    print(actual.by == expected.by)
    print(actual.ma == expected.ma)
    print(actual.mb == expected.mb)
    print(actual.ia == expected.ia)
    print(actual.ib == expected.ib)
    print(actual.total == expected.total)
}

func main() {
    var input0 = Input(ma:1.0, mb:1.0, ia:1.0, ib:1.0,
        ny:1.0, ax:1.0, bx:-1.0, separation:0.25,
        vax:1.0, vay:2.0, wa:0.5, vbx:3.0, vby:5.0, wb:-0.25,
        normal:2.0, tangent:-1.0, rolling:0.5,
        friction:0.75, restitution:0.25, tangent_speed:-0.5, rolling_resistance:0.125)
    var expected0 = Prepared(separation:0.25, normal_mass:0.25,
        tangent_mass:0.5, rolling_mass:0.5,
        relative_velocity:2.75, normal:2.0, tangent:-1.0, rolling:0.5,
        friction:0.75, restitution:0.25, tangent_speed:-0.5, rolling_resistance:0.125,
        bias_rate:12.0, mass_scale:0.75, impulse_scale:0.25,
        ny:1.0, ax:1.0, bx:-1.0, ma:1.0, mb:1.0, ia:1.0, ib:1.0)
    let warm0 = prepare(input0, true)
    observe(warm0, expected0)
    expected0.normal = 0.0
    expected0.tangent = 0.0
    expected0.rolling = 0.0
    observe(prepare(input0, false), expected0)
    input0.normal = 9.0
    print(warm0.normal == 2.0)
    var input1 = Input(ma:0.0, mb:1.0, ia:0.0, ib:1.0,
        ny:1.0, ax:1.0, bx:-1.0, separation:0.25,
        vax:1.0, vay:2.0, wa:0.5, vbx:3.0, vby:5.0, wb:-0.25,
        normal:2.0, tangent:-1.0, rolling:0.5,
        friction:0.75, restitution:0.25, tangent_speed:-0.5, rolling_resistance:0.125)
    var expected1 = Prepared(separation:0.25, normal_mass:0.5,
        tangent_mass:1.0, rolling_mass:1.0,
        relative_velocity:5.25, normal:2.0, tangent:-1.0, rolling:0.5,
        friction:0.75, restitution:0.25, tangent_speed:-0.5, rolling_resistance:0.125,
        bias_rate:24.0, mass_scale:0.875, impulse_scale:0.125,
        ny:1.0, ax:1.0, bx:-1.0, ma:0.0, mb:1.0, ia:0.0, ib:1.0)
    let warm1 = prepare(input1, true)
    observe(warm1, expected1)
    expected1.normal = 0.0
    expected1.tangent = 0.0
    expected1.rolling = 0.0
    observe(prepare(input1, false), expected1)
    input1.normal = 9.0
    print(warm1.normal == 2.0)
    var input2 = Input(ma:0.0, mb:0.0, ia:0.0, ib:0.0,
        ny:1.0, ax:1.0, bx:-1.0, separation:0.25,
        vax:1.0, vay:2.0, wa:0.5, vbx:3.0, vby:5.0, wb:-0.25,
        normal:2.0, tangent:-1.0, rolling:0.5,
        friction:0.75, restitution:0.25, tangent_speed:-0.5, rolling_resistance:0.125)
    var expected2 = Prepared(separation:0.25, normal_mass:0.0,
        tangent_mass:0.0, rolling_mass:0.0,
        relative_velocity:0.0, normal:2.0, tangent:-1.0, rolling:0.5,
        friction:0.75, restitution:0.25, tangent_speed:-0.5, rolling_resistance:0.125,
        bias_rate:24.0, mass_scale:0.875, impulse_scale:0.125,
        ny:1.0, ax:1.0, bx:-1.0, ma:0.0, mb:0.0, ia:0.0, ib:0.0)
    let warm2 = prepare(input2, true)
    observe(warm2, expected2)
    expected2.normal = 0.0
    expected2.tangent = 0.0
    expected2.rolling = 0.0
    observe(prepare(input2, false), expected2)
    input2.normal = 9.0
    print(warm2.normal == 2.0)
}
