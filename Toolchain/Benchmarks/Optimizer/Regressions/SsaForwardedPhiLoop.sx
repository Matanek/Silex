func accumulate(rounds:int) float64 {
    var value:float64 = 0.0
    var index = 0
    while index < rounds {
        if index % 2 == 0 {
            value += 1.0
        }
        index++
    }
    return value
}

func main() {
    assert(accumulate(0) == 0.0)
    assert(accumulate(1) == 1.0)
    assert(accumulate(4) == 2.0)
    print("forwarded SSA loop preserved")
}
