func increment(value:int8) int8 {
    if value < 100 {
        return value + 1
    }
    return value
}

func decrement(value:uint8) uint8 {
    if value > 0 {
        return value - 1
    }
    return value
}

func widen_unsigned(value:uint8) int16 {
    return value as int16
}

func shift_bounded(value:uint32) uint32 {
    return value << (5 as uint8)
}

func risky(value:int8) int8 {
    return value + 1
}

func accumulate(rounds:int) int {
    var value = 0
    var index = 0
    while index < rounds {
        if index % 2 == 0 {
            value += index % 97
        } else {
            value -= index % 31
        }
        value %= 1000003
        index++
    }
    return value
}

func main() {
    assert(increment(99) == 100)
    assert(increment(100) == 100)
    assert(decrement(1) == 0)
    assert(decrement(0) == 0)
    assert(widen_unsigned(255) == 255)
    assert(shift_bounded(3) == 96)
    assert(risky(1) == 2)
    assert(accumulate(0) == 0)
    assert(accumulate(4) == -2)
    print("integer range checks preserved")
}
