use STD.Math

struct Body {
    var velocity_x:float
    var velocity_y:float
    var angular_velocity:float
    var position_x:float
    var position_y:float
    var cosine:float
    var sine:float
}

// The system sqrt boundary is pure in Silex's observable model. Keeping that
// proof in portable IR lets this bounded branching helper inline at a hot site
// without admitting arbitrary native calls or larger pressure-heavy helpers.
func advance(body:&Body) {
    let step:float = 1.0 / 240.0
    let angle = step * body.angular_velocity
    let cosine = body.cosine - angle * body.sine
    let sine = body.sine + angle * body.cosine
    let magnitude = Math.sqrt(sine * sine + cosine * cosine)
    var inverse = 0.0
    if magnitude > 0.0 { inverse = 1.0 / magnitude }
    body.cosine = cosine * inverse
    body.sine = sine * inverse
    body.position_x += step * body.velocity_x
    body.position_y += step * body.velocity_y
}

func main() {
    var body = Body(
        velocity_x:3.0,
        velocity_y:4.0,
        angular_velocity:0.5,
        position_x:0.0,
        position_y:0.0,
        cosine:0.6,
        sine:0.8
    )
    var step = 0
    while step < 16 {
        advance(body)
        step++
    }
    assert(body.position_x > 0.19 && body.position_x < 0.21)
    assert(body.position_y > 0.26 && body.position_y < 0.28)
    assert(body.cosine > 0.59 && body.cosine < 0.61)
    assert(body.sine > 0.79 && body.sine < 0.81)
    print("pure math reference call preserved")
}
