struct Point { var x:float; var y:float }
struct Contact { var normal:Point; var anchor:Point; var impulse:float; var enabled:bool }

func project(contact:&Contact) float { return contact.impulse }
func project_view(contacts:@Contact[..], index:int) float { return contacts[index].normal.x }

func capture(contact:&Contact, contacts:&Contact[..], index:int, branch:bool) float {
    let saved = copy contact
    let item = contacts[index]
    contact.normal.x = 100.0
    contacts[index].anchor.y = 200.0
    if branch { return saved.normal.x + item.anchor.y }
    return saved.anchor.y + item.normal.x
}

func child(contact:&Contact) Point {
    let saved = copy contact
    contact.normal.x = 300.0
    return saved.normal
}

func main() {
    var contact = Contact(normal:Point(x:3.0, y:5.0), anchor:Point(x:7.0, y:11.0), impulse:13.0, enabled:true)
    var contacts:Contact[] = [Contact(normal:Point(x:17.0, y:19.0), anchor:Point(x:23.0, y:29.0), impulse:31.0, enabled:false)]
    assert(project(contact) == 13.0)
    assert(project_view(@contacts[0:1], -1) == 17.0)
    assert(capture(contact, &contacts[0:1], -1, true) == 32.0)
    assert(capture(contact, &contacts[0:1], 0, false) == 28.0)
    let saved = child(contact)
    assert(saved.x == 100.0 && saved.y == 5.0)
    assert(contact.normal.x == 300.0 && contact.impulse == 13.0 && contact.enabled)
    assert(contacts[0].anchor.y == 200.0 && contacts[0].normal.x == 17.0 && !contacts[0].enabled)
    print("nested aggregate read snapshots preserved")
}
