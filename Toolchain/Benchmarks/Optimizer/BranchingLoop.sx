func classify(rounds:int) int {
    var value = 0
    var index = 0
    while index < rounds {
        if index % 3 == 0 {
            value += index % 97
        } else {
            value -= index % 31
        }
        value %= 1000003
        index++
    }
    return value
}

func main() {
    print(classify(5000000))
}
