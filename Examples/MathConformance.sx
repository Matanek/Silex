use STD.Math

func main() {
    let precise_two:float64 = 2.0
    let expected_root:float64 = 1.4142135623730951
    let precise_tolerance:float64 = 1.0e-15
    assert(Math.nearly_equal(Math.sqrt(precise_two), expected_root, precise_tolerance))

    let angle:float64 = Math.pi<float64>() / 3.0
    let sine = Math.sin(angle)
    let cosine = Math.cos(angle)
    assert(Math.nearly_equal(sine * sine + cosine * cosine, 1.0 as float64, 1.0e-12 as float64))
    assert(Math.nearly_equal(Math.log(Math.exp(angle)), angle, 1.0e-12 as float64))
    assert(Math.pow(2.0 as float64, 10.0 as float64) == 1024.0 as float64)

    let tiny = Math.Vec3(0.0, 3.0e-30, 4.0e-30).normalized()
    let huge = Math.Vec3(0.0, 3.0e30, 4.0e30).normalized()
    assert(Math.nearly_equal(tiny.length(), 1.0))
    assert(Math.nearly_equal(huge.length(), 1.0))

    let translation = Math.Mat4.translation(Math.Vec3(10.0, 0.0, 0.0))
    let scaling = Math.Mat4.scaling(Math.Vec3(2.0, 2.0, 2.0))
    let point = Math.Vec4(Math.Vec3(1.0, 2.0, 3.0), 1.0)
    let direction = Math.Vec4(Math.Vec3(1.0, 2.0, 3.0), 0.0)
    let model = translation.multiply(scaling)
    assert(model.multiply(point) == Math.Vec4(12.0, 4.0, 6.0, 1.0))
    assert(translation.multiply(direction) == direction)

    let projection = Math.Mat4.perspective(Math.half_pi(), 1.0, 1.0, 10.0)
    let near = projection.multiply(Math.Vec4(0.0, 0.0, -1.0, 1.0))
    let far = projection.multiply(Math.Vec4(0.0, 0.0, -10.0, 1.0))
    assert(Math.nearly_equal(near.z / near.w, -1.0))
    assert(Math.nearly_equal(far.z / far.w, 1.0))
}
