use GFX.Color
use GFX.Drawing
use STD.Math

func main() {
    var font = Drawing.Font.default()
    var drawing = Drawing()
    drawing.paint(func(painter:&Drawing.Painter) {
        painter.text(
            "Silex",
            Math.Vec2(4.0),
            Drawing.TextStyle(size:18.0, color:Color.white(), font:font)
        )
    })
    let image = drawing.rasterize(96, 28)
    if image.width() != 96 || image.height() != 28 {
        panic("GFX did not rasterize the expected SDL_ttf image")
    }
}
