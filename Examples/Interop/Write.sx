use Interop.C
use Interop.MacOS

let write = C.function<
    func(int32, C.Pointer<uint8>, C.Size) C.SignedSize
>(
    library:MacOS.lib_system,
    name:"write"
)

func main() {
    let text = "Silex Interop\n"
    let written = write(1, C.pointer(text), C.byte_count(text))
    assert(written == C.byte_count(text) as C.SignedSize, "Interop write returned an unexpected byte count")
}
